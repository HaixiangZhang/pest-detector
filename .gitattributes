# Shell 脚本强制 LF：仓库在 Windows 开发、部署到 Linux，
# 若被 core.autocrlf 转成 CRLF，Linux 上会因 shebang 带 \r 而无法执行。
*.sh    text eol=lf
# Windows 批处理强制 CRLF
*.bat   text eol=crlf

# 大体积模型权重走 Git LFS（避免 124MB 的 best.pt 撑爆仓库历史）
# 启用方式（首次）: git lfs install
*.pt    filter=lfs diff=lfs merge=lfs -text
*.pth   filter=lfs diff=lfs merge=lfs -text
*.onnx  filter=lfs diff=lfs merge=lfs -text
*.engine filter=lfs diff=lfs merge=lfs -text