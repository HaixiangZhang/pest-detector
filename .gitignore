# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# 运行产物（每次运行都会生成，不入库）
runs/
logs/
data/
*.db
*.log

# 测试视频（体积大，不入库；需要时本地自备）
videos/

# 前端（源码与产物都在 app/web 下，路径需带 app/ 前缀）
app/web/node_modules/
# app/web/dist 随仓库发布（clone 后无需 Node 即可直接打开界面），故不忽略
app/web/.vite/
app/web/.npm-cache/
# 前端构建产物（源码是 vite.config.ts；tsc 生成的 .js/.d.ts 与 tsbuildinfo 不入库）
app/web/vite.config.js
app/web/vite.config.d.ts
app/web/*.tsbuildinfo

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 启动脚本缓存（记录上次探测到的项目解释器路径，双击启动用）
.pestdet-python

# 大体积模型权重由 .gitattributes 交给 Git LFS 管理（首次需 git lfs install），
# 因此这里不忽略 *.pt；若不想入库，取消下面注释
# *.pt